# Blocks SDK configuration for the FeatureTracker frontend.
#
# Copy this file to `.env` and fill in the values for your tenant. `.env` is
# gitignored — only `.env.example` is committed.
#
# Resolve the values with the Blocks CLI from the project root:
#
#   blocks projects get --json           # app domain (optional)
#   blocks auth oidc-clients list --json # the public OIDC client id
#
# OIDC URL discovery (per client):
#   https://iam.seliseblocks.com/<tenant-id>/.well-known/openid-configuration

# Blocks API base URL.
# Default: the global Blocks API. Works only for `*.seliseblocks.com` app domains.
# For custom app domains (e.g. `*.slsblx.com`), set this to
# `https://blocksapi.<registrable-domain>` instead — otherwise the Secure
# session cookie IAM sets on /login/callback never lands in the browser,
# and cookie-based calls (userInfo, logout, the OIDC callback flow) silently fail.
VITE_BLOCKS_API_URL=https://api.seliseblocks.com

# Blocks tenant key — sent as the `x-blocks-key` header on every request.
VITE_BLOCKS_KEY=

# Public OIDC client id registered for THIS app (PKCE public client).
# A blank value disables the login button — the LoginPage renders an
# `isLoginConfigured() === false` warning instead.
VITE_BLOCKS_OIDC_CLIENT_ID=

# OIDC discovery URL for the tenant. Used as `oidc.url` on `createBlocksClient`.
VITE_BLOCKS_OIDC_URL=

# Used as `appDomain` on `createBlocksClient` for client metadata.
# Required when the app runs on a custom (non-`*.seliseblocks.com`) domain;
# safe to leave blank for `*.seliseblocks.com`.
VITE_BLOCKS_APP_DOMAIN=

# ────────────────────────────────────────────────────────────────────────────
#  AI Assistant gateway (Issue Tracker chat panel)
# ────────────────────────────────────────────────────────────────────────────
# These vars are read by the Vite server (vite.config.ts → aiChatProxy plugin)
# and are intentionally NOT prefixed with `VITE_` — they must NEVER reach the
# browser bundle. The plugin attaches the bearer token server-side when the
# browser calls `/api/ai/chat`, so the token never ships in any JS chunk.
#
# Canonical names are `AI_GATEWAY_*`; the `ANTHROPIC_*` aliases below are also
# accepted (matching the names Claude Code / Anthropic SDK clients use), so
# `setx ANTHROPIC_AUTH_TOKEN "..."` works without renaming.
#
# Placeholder values below — replace the token in your local `.env`.

AI_GATEWAY_URL=
AI_GATEWAY_MODEL=
AI_GATEWAY_TOKEN=

# ────────────────────────────────────────────────────────────────────────────
#  Verification backend (Issue Tracker MCP integration — opt-in)
# ────────────────────────────────────────────────────────────────────────────
# When `VITE_USE_REAL_VERIFY=1`, the frontend calls `/api/verify/test` for the
# "Test Connection" button on VerificationTargets. When unset (default), the
# in-browser mock runs as it always has — no behaviour change for existing
# users.
#
# `VERIFY_BACKEND_URL` is server-side (no `VITE_` prefix); the Vite proxy
# forwards `/api/verify/*` requests there. If unset, the proxy returns 503
# and the client falls back to the mock, so flipping `VITE_USE_REAL_VERIFY=1`
# without a backend running still gives useful feedback.
#
# When the backend is live, set both. The expected shape of
# `POST /api/verify/test`:
#   request:  { targetId: string, url: string }
#   response: { urlReachable: boolean, loginSuccessful: boolean }

VITE_USE_REAL_VERIFY=
VERIFY_BACKEND_URL=
