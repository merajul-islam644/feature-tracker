# Copy to mail-server/.env.local (gitignored) and fill in.
# Blocks tenant values come from the repo root .env automatically —
# only the inbound-specific ones belong here.

# Shared secret the Cloudflare Email Worker sends in `x-inbound-secret`.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MAIL_INBOUND_SECRET=

# IAM credentials for the gateway session (the receiver logs in to read
# the blx_MailAddresses registry and write MailMessage rows).
Email=
Password=
